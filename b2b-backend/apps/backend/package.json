{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:e2e:upload": "npx medusa exec ./src/scripts/test-admin-upload.ts",
    "test:e2e:category-images": "npx medusa exec ./src/scripts/test-category-image-e2e.ts",
    "catalog:audit": "npx medusa exec ./src/scripts/audit-catalog-cutover.ts",
    "catalog:reconcile": "npx medusa exec ./src/scripts/reconcile-catalog-cutover.ts",
    "catalog:reconcile:apply": "npx medusa exec ./src/scripts/reconcile-catalog-cutover.ts apply",
    "catalog:verify": "npx medusa exec ./src/scripts/verify-catalog-cutover.ts",
    "catalog:fix-prices": "npx medusa exec ./src/scripts/fix-prices-major-units.ts",
    "catalog:fix-prices:apply": "npx medusa exec ./src/scripts/fix-prices-major-units.ts apply",
    "catalog:sync-wc-id": "npx medusa exec ./src/scripts/sync-wc-id-metadata.ts",
    "catalog:sync-wc-id:apply": "npx medusa exec ./src/scripts/sync-wc-id-metadata.ts apply",
    "catalog:remove-non-pen": "npx medusa exec ./src/scripts/remove-non-pen-prices.ts",
    "catalog:remove-non-pen:apply": "npx medusa exec ./src/scripts/remove-non-pen-prices.ts apply",
    "catalog:remove-usd": "npm run catalog:remove-non-pen",
    "catalog:remove-usd:apply": "npm run catalog:remove-non-pen:apply",
    "catalog:migrate-category-images": "npx medusa exec ./src/scripts/migrate-category-images.ts",
    "catalog:migrate-category-images:apply": "npx medusa exec ./src/scripts/migrate-category-images.ts apply"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.17.0",
    "@medusajs/admin-shared": "2.17.0",
    "@medusajs/caching": "2.17.0",
    "@medusajs/cli": "2.17.0",
    "@medusajs/dashboard": "2.17.0",
    "@medusajs/draft-order": "2.17.0",
    "@medusajs/framework": "2.17.0",
    "@medusajs/js-sdk": "2.17.0",
    "@medusajs/medusa": "2.17.0",
    "@medusajs/ui": "4.1.15",
    "@tanstack/react-query": "5.64.2",
    "altcha-lib": "^2.3.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.3",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.17.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "pg-god": "^1.0.12",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1"
}
